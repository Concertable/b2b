<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Concertable B2B deal contracts: the DealType union and its per-type terms, shared by every consumer that reads or settles a B2B deal.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Concertable.B2B.Enums\Concertable.B2B.Enums.csproj" />
    <ProjectReference Include="..\Concertable.B2B.Deal.Domain\Concertable.B2B.Deal.Domain.csproj" />
  </ItemGroup>

  <!-- Keep as PackageReference, never a ProjectReference: a cross-folder escape from api/Concertable.B2B/ breaks the standalone carve (see Directory.Build.props). -->
  <ItemGroup>
    <PackageReference Include="Concertable.Contracts" />
    <PackageReference Include="Concertable.Kernel" />
    <PackageReference Include="Dunet" />
    <PackageReference Include="Reunion" />
    <PackageReference Include="Reunion.Errors" />
  </ItemGroup>

</Project>
