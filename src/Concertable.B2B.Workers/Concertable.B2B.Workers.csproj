<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>concertable/b2b-workers</ContainerRepository>
    <!-- The Functions host, not the plain runtime base the SDK would pick: this stays a native Functions
         app so its TimerTrigger keeps working, and the same digest runs locally, in system E2E and on
         Azure Functions on Container Apps. Consumption cannot run a custom container at all. -->
    <ContainerBaseImage>mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated10.0</ContainerBaseImage>
    <!-- The Functions host looks for the app at this fixed path and is the image's own entrypoint, so the
         payload goes there and the SDK must not overwrite the entrypoint with `dotnet Workers.dll`. -->
    <ContainerWorkingDirectory>/home/site/wwwroot</ContainerWorkingDirectory>
    <ContainerAppCommandInstruction>None</ContainerAppCommandInstruction>
  </PropertyGroup>

  <ItemGroup>
    <ContainerEnvironmentVariable Include="AzureWebJobsScriptRoot" Value="/home/site/wwwroot" />
    <ContainerEnvironmentVariable Include="AzureFunctionsJobHost__Logging__Console__IsEnabled" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Admin\Concertable.B2B.Admin.Infrastructure\Concertable.B2B.Admin.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Artist\Concertable.B2B.Artist.Infrastructure\Concertable.B2B.Artist.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Tenant\Concertable.B2B.Tenant.Infrastructure\Concertable.B2B.Tenant.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\User\Concertable.B2B.User.Infrastructure\Concertable.B2B.User.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Concert\Concertable.B2B.Concert.Infrastructure\Concertable.B2B.Concert.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Deal\Concertable.B2B.Deal.Infrastructure\Concertable.B2B.Deal.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Venue\Concertable.B2B.Venue.Infrastructure\Concertable.B2B.Venue.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Conversations\Concertable.B2B.Conversations.Infrastructure\Concertable.B2B.Conversations.Infrastructure.csproj" />
    <ProjectReference Include="..\Seed\Concertable.B2B.Seed.Infrastructure\Concertable.B2B.Seed.Infrastructure.csproj" />
    <ProjectReference Include="..\Concertable.B2B.Infrastructure\Concertable.B2B.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Keep as PackageReference, never a ProjectReference: a cross-folder escape from api/Concertable.B2B/ breaks the standalone carve (see Directory.Build.props). -->
  <ItemGroup>
    <PackageReference Include="Concertable.Kernel" />
    <PackageReference Include="Concertable.Messaging.Infrastructure" />
    <PackageReference Include="Concertable.Payment.Client" />
    <PackageReference Include="Concertable.Seed.Shared" />
    <PackageReference Include="Concertable.ServiceDefaults" />
    <PackageReference Include="Concertable.Shared.Blob.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Email.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Geocoding.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Imaging.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Notification.Infrastructure" />
    <PackageReference Include="Concertable.Shared.Pdf.Infrastructure" />
  </ItemGroup>

</Project>
