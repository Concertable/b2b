<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ConcertableDotNetPlatformVersion>0.2.0-alpha.0.14</ConcertableDotNetPlatformVersion>
    <!-- Each service publishes on its own train, so a service package cannot track the platform
         version; a shared literal here silently ships a stale client for whichever service moved. -->
    <ConcertableAuthVersion>0.2.0-alpha.0.305</ConcertableAuthVersion>
    <ConcertableCustomerVersion>0.1.0-alpha.0.1381</ConcertableCustomerVersion>
    <ConcertablePaymentVersion>0.2.0-alpha.0.381</ConcertablePaymentVersion>
    <ConcertableSearchVersion>0.2.0-alpha.0.330</ConcertableSearchVersion>
    <ConcertableSystemVersion>0.2.0-alpha.0.212</ConcertableSystemVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Concertable.Testing" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Testing.Architecture" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Testing.Integration" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Testing.E2E" Version="$(ConcertableSystemVersion)" />
    <PackageVersion Include="Concertable.E2E" Version="$(ConcertableSystemVersion)" />
    <PackageVersion Include="Concertable.Payment.E2ETests.Helpers" Version="$(ConcertableSystemVersion)" />
    <PackageVersion Include="Concertable.Payment.TestKit" Version="$(ConcertablePaymentVersion)" />
    <PackageVersion Include="Concertable.Auth.Hosting" Version="$(ConcertableAuthVersion)" />
    <PackageVersion Include="Concertable.Payment.Hosting" Version="$(ConcertablePaymentVersion)" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.1.2" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.3.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.3.2" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.3.2" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.3.2" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.1.2" />
    <PackageVersion Include="Dunet" Version="1.16.2" />
    <PackageVersion Include="Dapper" Version="2.1.72" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Cors" Version="2.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.4" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
    <PackageVersion Include="Microsoft.NET.Sdk.Functions" Version="4.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Microsoft.NETCore.Targets" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageVersion Include="Mjml.Net" Version="4.14.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="PdfPig" Version="0.1.15" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <PackageVersion Include="QuestPDF" Version="2025.1.3" />
    <PackageVersion Include="Reqnroll.Microsoft.Extensions.DependencyInjection" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.xUnit" Version="3.3.4" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Reunion" Version="0.1.0-alpha.14" />
    <PackageVersion Include="Reunion.AspNetCore" Version="0.1.0-alpha.14" />
    <PackageVersion Include="Reunion.Errors" Version="0.1.0-alpha.14" />
    <PackageVersion Include="Reunion.Validation" Version="0.1.0-alpha.14" />
    <PackageVersion Include="Scriban" Version="7.2.6" />
    <PackageVersion Include="Stripe.net" Version="47.3.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.11.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <!-- Shared platform packages from the org feed, pinned lockstep via
       ConcertableDotNetPlatformVersion above; each cross-service contract tracks its owning
       service's train instead. Bump only to a version already published to the feed,
       else restore fails NU1101. The churny core (Kernel, Messaging.*) is consumed as packages
       by default; set UseLocalCore=true (env CONCERTABLE_LOCAL_CORE) to switch it to in-repo
       ProjectReferences for fast cross-cutting local dev — see Directory.Build.props. -->
  <ItemGroup>
    <PackageVersion Include="Concertable.Kernel" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Contracts" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.DataAccess.Application" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.DataAccess.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.ServiceDefaults" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Api" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Notification.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Blob.Application" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Blob.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Email.Application" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Email.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Geocoding.Application" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Geocoding.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Imaging.Application" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Imaging.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Pdf.Application" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Shared.Pdf.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Messaging.Contracts" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Messaging.Domain" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Messaging.Application" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Messaging.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Messaging.AzureServiceBus" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Seed.Shared" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Seed.Identity" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Seed.Infrastructure" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.AppHost.Shared" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Frontend.Hosting" Version="$(ConcertableDotNetPlatformVersion)" />
    <PackageVersion Include="Concertable.Search.Hosting" Version="$(ConcertableSearchVersion)" />
    <PackageVersion Include="Concertable.Auth.Contracts" Version="$(ConcertableAuthVersion)" />
    <PackageVersion Include="Concertable.Payment.Client" Version="$(ConcertablePaymentVersion)" />
    <PackageVersion Include="Concertable.Payment.Contracts" Version="$(ConcertablePaymentVersion)" />
    <PackageVersion Include="Concertable.Customer.Review.Contracts" Version="$(ConcertableCustomerVersion)" />
    <PackageVersion Include="Concertable.Customer.Ticket.Contracts" Version="$(ConcertableCustomerVersion)" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.98" />
    <GlobalPackageReference Include="Concertable.Build" Version="$(ConcertableDotNetPlatformVersion)" />
    <GlobalPackageReference Include="MinVer" Version="7.0.0" />
  </ItemGroup>

</Project>
