{
  "name": "@concertable/b2b",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concertable/concertable.git",
    "directory": "app/b2b/shared"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm test",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "test": "vitest run src",
    "prepack": "npm run build"
  },
  "exports": {
    "./features/artists": {
      "types": "./dist/features/artists/index.d.ts",
      "import": "./dist/features/artists/index.js",
      "default": "./dist/features/artists/index.js"
    },
    "./features/venues": {
      "types": "./dist/features/venues/index.d.ts",
      "import": "./dist/features/venues/index.js",
      "default": "./dist/features/venues/index.js"
    },
    "./features/tenant": {
      "types": "./dist/features/tenant/index.d.ts",
      "import": "./dist/features/tenant/index.js",
      "default": "./dist/features/tenant/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@concertable/shared": "*",
    "@tanstack/react-query": "^5.90.21",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "tsc-alias": "^1.9.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
