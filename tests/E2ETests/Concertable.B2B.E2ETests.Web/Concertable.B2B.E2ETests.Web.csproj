<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <CompositionValidationExclusion>E2E admin executable covered by the production B2B Web composition root.</CompositionValidationExclusion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Concertable.B2B.Web\Concertable.B2B.Web.csproj" />
    <ProjectReference Include="..\Concertable.B2B.E2ETests.Server\Concertable.B2B.E2ETests.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\src\Concertable.B2B.Web\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\Concertable.B2B.Web\appsettings.E2E.json" Link="appsettings.E2E.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
