<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Reunion" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Reference the composition root so every module's compiled assembly (Contracts/Domain/
       Application/Infrastructure/Api) lands in the output for ArchUnitNET to load and analyse; the same
       host graphs are what the dynamic host-graph fitness functions in B2BHostGraphTests build. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Concertable.B2B.Web\Concertable.B2B.Web.csproj" />
    <ProjectReference Include="..\..\src\Concertable.B2B.Workers\Concertable.B2B.Workers.csproj" />
    <ProjectReference Include="..\..\src\Seed\Concertable.B2B.Seed.Simulator\Concertable.B2B.Seed.Simulator.csproj" />
    <ProjectReference Include="..\..\src\Concertable.B2B.AppHost\Concertable.B2B.AppHost.csproj" />
    <ProjectReference Include="..\..\src\Modules\Admin\Concertable.B2B.Admin.Contracts\Concertable.B2B.Admin.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\**\*.IntegrationTests.csproj" />
    <ProjectReference Include="..\Concertable.B2B.IntegrationTests.Fixtures\Concertable.B2B.IntegrationTests.Fixtures.csproj" />
    <ProjectReference Include="..\..\..\Concertable.Shared\tests\Concertable.Testing\Concertable.Testing.csproj" />
    <ProjectReference Include="..\..\..\Concertable.Shared\tests\Concertable.Composition.Testing\Concertable.Composition.Testing.csproj" Condition="'$(UseLocalPlatformPackages)' != 'true' And Exists('..\..\..\Concertable.Shared\tests\Concertable.Composition.Testing\Concertable.Composition.Testing.csproj')" />
    <PackageReference Include="Concertable.Composition.Testing" Condition="'$(UseLocalPlatformPackages)' == 'true' Or !Exists('..\..\..\Concertable.Shared\tests\Concertable.Composition.Testing\Concertable.Composition.Testing.csproj')" />
  </ItemGroup>

</Project>
